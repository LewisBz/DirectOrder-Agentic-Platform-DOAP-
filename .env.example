# Postgres bootstrap (superuser of the container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=doap

# Table owner / Atlas migrations (not used by the API)
POSTGRES_OWNER_USER=doap_owner
POSTGRES_OWNER_PASSWORD=changeme_owner

# Application role (NOBYPASSRLS). API uses this user only.
POSTGRES_APP_USER=doap_app
POSTGRES_APP_PASSWORD=changeme_app

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

API_ADDR=:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
